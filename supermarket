/* =====================================
   FUNGSI HITUNG JUMLAH DATA
===================================== */

function jumlahData($conn, $table)
{
    $allowedTables = [
        'produk',
        'pelanggan',
        'supplier',
        'karyawan'
    ];

    if (!in_array($table, $allowedTables)) {
        return 0;
    }

    $query = "SELECT COUNT(*) AS total FROM `$table`";
    $result = $conn->query($query);

    if ($result) {
        $data = $result->fetch_assoc();
        return (int)$data['total'];
    }

    return 0;
}


/* =====================================
   DATA DASHBOARD
===================================== */

$totalProduk = jumlahData($conn, "produk");
$totalPelanggan = jumlahData($conn, "pelanggan");
$totalSupplier = jumlahData($conn, "supplier");
$totalKaryawan = jumlahData($conn, "karyawan");


/* =====================================
   TOTAL PENJUALAN HARI INI
===================================== */

$totalHariIni = 0;

$queryHariIni = "
    SELECT COALESCE(SUM(total_penjualan), 0) AS total
    FROM penjualan
    WHERE tanggal_penjualan = CURDATE()
";

$resultHariIni = $conn->query($queryHariIni);

if ($resultHariIni) {
    $dataHariIni = $resultHariIni->fetch_assoc();
    $totalHariIni = $dataHariIni['total'];
}


/* =====================================
   PRODUK STOK MENIPIS
===================================== */

$queryStok = "
    SELECT
        p.id_produk,
        p.nama_produk,
        k.nama_kategori,
        p.stok,
        p.stok_minimum,
        p.satuan
    FROM produk p
    LEFT JOIN kategori k
        ON p.id_kategori = k.id_kategori
    WHERE p.stok <= p.stok_minimum
    ORDER BY p.stok ASC
    LIMIT 10
";

$resultStok = $conn->query($queryStok);


/* =====================================
   FORMAT RUPIAH
===================================== */

function rupiah($angka)
{
    return "Rp " . number_format(
        $angka,
        0,
        ',',
        '.'
    );
}

